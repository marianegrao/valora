{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "globalSetup": "<rootDir>/testcontainers-setup.js",
  "globalTeardown": "<rootDir>/testcontainers-teardown.js",
  "testTimeout": 30000
}
